---
import { profile } from '@data/profile';
import { layoutCopy, localeMeta, localizedRoutes, type Locale } from '@data/i18n';

type Props = {
  lang?: Locale;
  alternatePath?: string;
};

const { lang = 'es', alternatePath } = Astro.props;
const copy = layoutCopy[lang];
const routes = localizedRoutes[lang];
const alternateLang = lang === 'es' ? 'en' : 'es';
const languageHref = alternatePath ?? localizedRoutes[alternateLang].home;
---

<header class="site-header">
  <nav class="container nav" aria-label={copy.navigationLabel}>
    <a class="brand" href={routes.home} aria-label={copy.brandLabel}>
      <span class="brand-mark">DE</span>
      <span>{profile.name}</span>
    </a>
    <div class="nav-links">
      <a href={`${routes.home}#perfil`}>{copy.profile}</a>
      <a href={`${routes.home}#stack`}>{copy.stack}</a>
      <a href={`${routes.home}#experiencia`}>{copy.experience}</a>
      <a href={`${routes.home}#youtube`}>{copy.authority}</a>
      <a class="language-link" href={languageHref} hreflang={localeMeta[alternateLang].htmlLang} aria-label={copy.languageLabel}>{localeMeta[alternateLang].label}</a>
      <a class="contact-link" href={`${routes.home}#contacto`}>{copy.contact}</a>
    </div>
  </nav>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
    background: rgba(7, 11, 18, 0.78);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
  }

  .site-header-spacer {
    height: 73px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }

  .brand,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.75rem;
    font-weight: 700;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    color: #06101a;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .nav-links {
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .contact-link,
  .language-link {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-weight: 800;
  }

  .contact-link {
    color: #06101a;
    background: var(--color-primary);
  }

  .language-link {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 840px) {
    .site-header-spacer {
      height: 132px;
    }

    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.85rem;
      padding-block: 0.9rem;
    }

    .nav-links {
      overflow-x: auto;
      width: 100%;
      gap: 0.75rem;
      padding-bottom: 0.45rem;
      scroll-padding-inline: var(--container-gutter);
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .brand {
      max-width: 100%;
      font-size: 0.95rem;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 0.75rem;
    }

    .nav-links {
      font-size: 0.88rem;
    }

    .contact-link,
    .language-link {
      padding: 0.55rem 0.75rem;
    }
  }
</style>
