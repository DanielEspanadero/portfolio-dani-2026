---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAADH3YGBC1zjwCVDA';

type Props = {
  lang?: 'es' | 'en';
};

const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Contacto',
    title: 'Hablemos de backend, arquitectura o IA aplicada.',
    description: 'Si querés contactar conmigo por una oportunidad profesional, colaboración o propuesta técnica, escribime desde este formulario.',
    name: 'Nombre',
    email: 'Email',
    message: 'Mensaje',
    honeypot: 'No rellenar este campo',
    turnstile: 'Verificación anti spam de Cloudflare',
    warning: 'La verificación anti spam no está configurada.',
    success: 'Mensaje enviado correctamente. Gracias, te responderé pronto.',
    invalid: 'No se pudo enviar el mensaje. Revisá los campos y completá la verificación anti spam.',
    error: 'Hubo un problema enviando el mensaje. Probá de nuevo en unos minutos.',
    submit: 'Enviar mensaje',
  },
  en: {
    eyebrow: 'Contact',
    title: 'Let’s talk about backend, architecture or applied AI.',
    description: 'If you want to reach out about a professional opportunity, collaboration or technical proposal, send me a message through this form.',
    name: 'Name',
    email: 'Email',
    message: 'Message',
    honeypot: 'Do not fill this field',
    turnstile: 'Cloudflare anti-spam verification',
    warning: 'The anti-spam verification is not configured.',
    success: 'Message sent successfully. Thanks, I will reply soon.',
    invalid: 'The message could not be sent. Check the fields and complete the anti-spam verification.',
    error: 'There was a problem sending the message. Try again in a few minutes.',
    submit: 'Send message',
  },
}[lang];
---

<section id="contacto" class="section container" aria-labelledby="contact-title">
  <div class="surface contact">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="contact-title" class="section-title">{copy.title}</h2>
      <p class="section-description">
        {copy.description}
      </p>
    </div>
    <form class="form" action="/api/contact" method="post" novalidate data-lang={lang}>
      <label for="contact-name">
        {copy.name}
        <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="3" maxlength="80" pattern="^[A-Za-zÀ-ÿÑñ0-9][A-Za-zÀ-ÿÑñ0-9 .'-]{1,78}[A-Za-zÀ-ÿÑñ0-9]$" aria-describedby="contact-name-error" />
        <span id="contact-name-error" class="field-error" data-error-for="name" aria-live="polite"></span>
      </label>
      <label for="contact-email">
        {copy.email}
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" inputmode="email" aria-describedby="contact-email-error" />
        <span id="contact-email-error" class="field-error" data-error-for="email" aria-live="polite"></span>
      </label>
      <label for="contact-message">
        {copy.message}
        <textarea id="contact-message" name="message" required minlength="20" maxlength="3000" aria-describedby="contact-message-error"></textarea>
        <span id="contact-message-error" class="field-error" data-error-for="message" aria-live="polite"></span>
      </label>
      <label class="honeypot" aria-hidden="true">
        {copy.honeypot}
        <input name="company" type="text" tabindex="-1" autocomplete="off" />
      </label>
      {turnstileSiteKey ? (
        <div class="turnstile-wrap" aria-label={copy.turnstile}>
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-action="contact"></div>
        </div>
      ) : (
        <p class="form-warning">{copy.warning}</p>
      )}
      <p class="form-status" data-form-status hidden aria-live="polite" data-success={copy.success} data-invalid={copy.invalid} data-error={copy.error}></p>
      <button type="submit">{copy.submit}</button>
    </form>
  </div>
</section>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('.form[action="/api/contact"]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const formLang = form?.dataset.lang === 'en' ? 'en' : 'es';

  const messages = {
    es: {
      nameMin: 'El nombre debe tener al menos 3 caracteres.',
      nameMax: 'El nombre no puede superar 80 caracteres.',
      nameNoUrls: 'El nombre no debe incluir URLs ni emails.',
      nameInvalid: 'Usá un nombre válido, sin símbolos raros.',
      emailRequired: 'Introducí tu email.',
      emailLong: 'El email es demasiado largo.',
      emailInvalid: 'Introducí un email válido.',
      emailDomain: 'El dominio del email no parece válido.',
      messageMin: 'El mensaje debe tener al menos 20 caracteres.',
      messageMax: 'El mensaje no puede superar 3000 caracteres.',
      messageNoHtml: 'No pegues HTML ni etiquetas en el mensaje.',
      messageNoExecutable: 'No pegues código ejecutable en el mensaje.',
      messageSuspicious: 'El mensaje contiene instrucciones automatizadas sospechosas.',
      messageUnreadable: 'El mensaje necesita contenido legible.',
    },
    en: {
      nameMin: 'Name must be at least 3 characters long.',
      nameMax: 'Name cannot be longer than 80 characters.',
      nameNoUrls: 'Name must not include URLs or email addresses.',
      nameInvalid: 'Use a valid name without unusual symbols.',
      emailRequired: 'Enter your email address.',
      emailLong: 'Email is too long.',
      emailInvalid: 'Enter a valid email address.',
      emailDomain: 'The email domain does not look valid.',
      messageMin: 'Message must be at least 20 characters long.',
      messageMax: 'Message cannot be longer than 3000 characters.',
      messageNoHtml: 'Do not paste HTML or tags in the message.',
      messageNoExecutable: 'Do not paste executable code in the message.',
      messageSuspicious: 'The message contains suspicious automated instructions.',
      messageUnreadable: 'The message needs readable content.',
    },
  }[formLang];

  const validators = {
    name(value: string) {
      const trimmed = value.trim();

      if (trimmed.length < 3) return messages.nameMin;
      if (trimmed.length > 80) return messages.nameMax;
      if (/https?:\/\//i.test(trimmed) || /@/.test(trimmed)) return messages.nameNoUrls;
      if (!/^[A-Za-zÀ-ÿÑñ0-9][A-Za-zÀ-ÿÑñ0-9 .'-]{1,78}[A-Za-zÀ-ÿÑñ0-9]$/.test(trimmed)) return messages.nameInvalid;

      return '';
    },
    email(value: string) {
      const trimmed = value.trim();
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      if (!trimmed) return messages.emailRequired;
      if (trimmed.length > 254) return messages.emailLong;
      if (!emailPattern.test(trimmed)) return messages.emailInvalid;
      if (trimmed.includes('..')) return messages.emailInvalid;

      const [local, domain] = trimmed.split('@');
      if (!local || !domain || local.length > 64) return messages.emailInvalid;
      if (!domain.includes('.') || domain.startsWith('.') || domain.endsWith('.')) return messages.emailDomain;

      return '';
    },
    message(value: string) {
      const trimmed = value.trim();

      if (trimmed.length < 20) return messages.messageMin;
      if (trimmed.length > 3000) return messages.messageMax;
      if (/<\/?[a-z][\s\S]*>/i.test(trimmed)) return messages.messageNoHtml;
      if (/\b(?:javascript|data|vbscript)\s*:/i.test(trimmed)) return messages.messageNoExecutable;
      if (/\b(?:ignore|ignora|olvida|descarta)\b.{0,90}\b(?:previous|anteriores|instrucciones|instructions|system|sistema|developer)\b/i.test(trimmed)) return messages.messageSuspicious;
      if (new Set(trimmed.replace(/\s/g, '')).size < 5) return messages.messageUnreadable;

      return '';
    },
  };

  const contactStatus = new URLSearchParams(window.location.search).get('contact');

  if (status && contactStatus) {
    const state = contactStatus === 'ok' ? 'success' : contactStatus === 'invalid' || contactStatus === 'error' ? contactStatus : undefined;
    const message = state ? status.dataset[state] : undefined;

    if (message) {
      status.textContent = message;
      status.hidden = false;
      status.dataset.state = state === 'success' ? 'success' : 'error';
    }
  }

  function setFieldError(field: HTMLInputElement | HTMLTextAreaElement, message: string) {
    const error = form?.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);

    field.setAttribute('aria-invalid', message ? 'true' : 'false');

    if (error) {
      error.textContent = message;
    }
  }

  function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
    const validator = validators[field.name as keyof typeof validators];
    const message = validator ? validator(field.value) : '';

    setFieldError(field, message);

    return !message;
  }

  form?.addEventListener('input', (event) => {
    const field = event.target;

    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
      validateField(field);
    }
  });

  form?.addEventListener('submit', (event) => {
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name="name"], input[name="email"], textarea[name="message"]'));
    const isValid = fields.every(validateField);

    if (!isValid) {
      event.preventDefault();
      fields.find((field) => field.getAttribute('aria-invalid') === 'true')?.focus();
    }
  });
</script>

<style>
  .section {
    padding-block: var(--section-space);
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
    gap: clamp(1.5rem, 4vw, 2rem);
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: rgba(7, 11, 18, 0.84);
    padding: 0.85rem 1rem;
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: rgba(248, 113, 113, 0.82);
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.12);
  }

  .field-error {
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .field-error {
    min-height: 1.2em;
    color: #fca5a5;
  }

  .turnstile-wrap {
    display: flex;
    justify-content: center;
    overflow: hidden;
    min-height: 65px;
  }

  .form-warning {
    margin: 0;
    border: 1px solid rgba(248, 199, 126, 0.28);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    color: rgba(248, 199, 126, 0.95);
    background: rgba(248, 199, 126, 0.08);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .form-status {
    margin: 0;
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .form-status[data-state='success'] {
    border: 1px solid rgba(52, 211, 153, 0.34);
    color: rgba(167, 243, 208, 0.96);
    background: rgba(52, 211, 153, 0.1);
  }

  .form-status[data-state='error'] {
    border: 1px solid rgba(248, 113, 113, 0.34);
    color: rgba(254, 202, 202, 0.96);
    background: rgba(248, 113, 113, 0.1);
  }

  textarea {
    min-height: 150px;
    resize: vertical;
  }

  button {
    border: 0;
    border-radius: 999px;
    color: #06101a;
    background: var(--color-primary);
    padding: 0.9rem 1rem;
    font-weight: 800;
    cursor: pointer;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .section {
      padding-block: var(--section-space-sm);
    }

    .contact {
      padding: 1.15rem;
    }

    input,
    textarea {
      padding: 0.8rem 0.9rem;
    }

    button {
      min-height: 48px;
    }
  }
</style>
