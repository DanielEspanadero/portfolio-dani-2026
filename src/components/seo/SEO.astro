---
import { defaultSeo } from '@data/seo';
import { localeMeta, type Locale } from '@data/i18n';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  lang?: Locale;
  alternatePath?: string;
};

const {
  title = defaultSeo.title,
  description = defaultSeo.description,
  image = defaultSeo.image,
  imageAlt,
  type = 'website',
  lang = 'es',
  alternatePath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const alternateURL = alternatePath ? new URL(alternatePath, Astro.site) : null;
const defaultURL = new URL('/', Astro.site);
const alternateLang = lang === 'es' ? 'en' : 'es';
const resolvedImageAlt = imageAlt ?? (lang === 'es'
  ? 'Daniel Españadero, Backend Software Engineer especializado en Java, Spring Boot e IA'
  : 'Daniel Españadero, Backend Software Engineer specialized in Java, Spring Boot and AI');
---

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{alternateURL && <link rel="alternate" hreflang={localeMeta[alternateLang].htmlLang} href={alternateURL} />}
<link rel="alternate" hreflang={localeMeta[lang].htmlLang} href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={defaultURL} />

<meta property="og:type" content={type} />
<meta property="og:locale" content={localeMeta[lang].ogLocale} />
{alternateURL && <meta property="og:locale:alternate" content={localeMeta[alternateLang].ogLocale} />}
<meta property="og:site_name" content={defaultSeo.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={resolvedImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />
