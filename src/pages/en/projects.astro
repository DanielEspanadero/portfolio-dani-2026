---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { profile } from '@data/profile';

const lang = 'en';
const alternatePath = '/proyectos/';
const title = 'Daniel Españadero Backend Projects | Java, Spring Boot and architecture';
const description = 'Projects and technical content by Daniel Españadero about Java, Spring Boot, hexagonal architecture, AWS, concurrency and backend development.';

const projects = [
  {
    title: 'Hexagonal architecture with Java',
    description: 'Technical content on how to structure decoupled and maintainable backend applications.',
    href: 'https://www.youtube.com/watch?v=JD_ZL3Bnaog',
  },
  {
    title: 'AWS EC2 and RDS',
    description: 'Deployment and basic infrastructure for backend applications with AWS services.',
    href: 'https://www.youtube.com/watch?v=gEWqXYlC4ak',
  },
  {
    title: 'Concurrency',
    description: 'Technical explanation of concurrency concepts applied to backend development.',
    href: 'https://www.youtube.com/watch?v=cskoNJCWMws',
  },
];

const projectsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `${profile.website}/en/projects/`,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        name: project.title,
        description: project.description,
        url: project.href,
        author: { '@type': 'Person', name: profile.name },
      },
    })),
  },
};
---

<BaseLayout {title} {description} {lang} {alternatePath}>
  <JsonLd data={projectsSchema} />
  <section class="container page">
    <p class="eyebrow">Projects</p>
    <h1>Content and projects that demonstrate technical judgment.</h1>
    <p class="lead">
      A curated selection focused on Java backend, Spring Boot, hexagonal architecture, concurrency and cloud infrastructure applied to real systems.
    </p>
    <div class="grid">
      {projects.map((project) => (
        <article class="surface card">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <a href={project.href} target="_blank" rel="noreferrer">View resource</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--section-space); }
  h1 { max-width: 900px; margin: 0; font-size: clamp(2.6rem, 10vw, 6rem); line-height: 0.98; letter-spacing: clamp(-0.07em, -0.8vw, -0.035em); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.85rem, 2vw, 1rem); margin-top: clamp(2rem, 5vw, 3rem); }
  .lead { max-width: 760px; color: var(--color-text-muted); font-size: clamp(1rem, 2.4vw, 1.18rem); line-height: 1.7; }
  .card { padding: clamp(1.1rem, 3vw, 1.4rem); }
  .card p { color: var(--color-text-muted); line-height: 1.7; }
  .card a { color: var(--color-accent); font-weight: 700; }
  @media (max-width: 920px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .page { padding-block: var(--section-space-sm); } }
</style>
